{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(products|services|retailbiz)/?",
      "has": [{ "type": "host", "value": "(www\\.)?slatebiz\\.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/((?!assets/|seo/|robots\\.txt$|sitemap\\.xml$)(?!.*\\.(?:js|css|map|json|txt|xml|webp|png|jpe?g|svg|ico|woff2|mp4|webmanifest)$).+)",
      "has": [{ "type": "host", "value": "(www\\.)?(jewelbiz|curabiz)\\.in" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/jewelbiz(/.*)?",
      "has": [{ "type": "host", "value": "(www\\.)?slatebiz\\.(com|in)" }],
      "destination": "https://www.jewelbiz.in/",
      "permanent": true
    },
    {
      "source": "/curabiz(/.*)?",
      "has": [{ "type": "host", "value": "(www\\.)?slatebiz\\.(com|in)" }],
      "destination": "https://www.curabiz.in/",
      "permanent": true
    },
    {
      "source": "/jewelbiz(/.*)?",
      "has": [{ "type": "host", "value": "(www\\.)?jewelbiz\\.in" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/curabiz(/.*)?",
      "has": [{ "type": "host", "value": "(www\\.)?curabiz\\.in" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?slatebiz\\.in" }],
      "destination": "https://www.slatebiz.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "(www\\.)?jewelbiz\\.in" }],
      "destination": "/seo/sitemap-jewelbiz.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "(www\\.)?curabiz\\.in" }],
      "destination": "/seo/sitemap-curabiz.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/seo/sitemap-slatebiz.xml"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "(www\\.)?jewelbiz\\.in" }],
      "destination": "/seo/robots-jewelbiz.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "(www\\.)?curabiz\\.in" }],
      "destination": "/seo/robots-curabiz.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/seo/robots-slatebiz.txt"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(www\\.)?jewelbiz\\.in" }],
      "destination": "/_pages/jewelbiz/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(www\\.)?curabiz\\.in" }],
      "destination": "/_pages/curabiz/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(www\\.)?slatebiz\\.com" }],
      "destination": "/_pages/slatebiz/index.html"
    },
    {
      "source": "/(products|services|about-us|contact|retailbiz|blogs|terms-of-use|privacy-policy|careers|faq)/?",
      "has": [{ "type": "host", "value": "(www\\.)?slatebiz\\.com" }],
      "destination": "/_pages/slatebiz/$1.html"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/app-shell.html"
    }
  ]
}
